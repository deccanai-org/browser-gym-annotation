# Rendered by nginx's envsubst entrypoint. From the env: ${PORT} (Cloud Run
# injects it; 8080 locally), ${BACKEND_ORIGIN} (backend service URL) and
# ${BACKEND_HOST} (its hostname). The Host header MUST be the backend's hostname
# so Cloud Run routes correctly, and proxy_ssl_server_name sends SNI for the
# HTTPS upstream — without these, /api 404s in a hosted deploy.
server {
  listen ${PORT};
  server_name _;
  root /usr/share/nginx/html;

  # API → backend service (same-origin to the browser; proxied server-side).
  location /api/ {
    proxy_pass ${BACKEND_ORIGIN};
    proxy_http_version 1.1;
    proxy_set_header Host ${BACKEND_HOST};
    proxy_ssl_server_name on;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 300s;
  }

  # Hashed build assets are immutable — their name changes when the content does,
  # so they can be cached forever.
  location /assets/ {
    try_files $uri =404;
    add_header Cache-Control "public, max-age=31536000, immutable";
  }

  # SPA fallback. index.html MUST NOT be cached: it is the only file whose name
  # never changes, and it is what points at the current hashed bundle. A cached
  # copy keeps loading yesterday's JS after a redeploy — which is exactly how a
  # rebuilt UI kept showing the old screen until a manual hard-reload.
  location / {
    try_files $uri /index.html;
    add_header Cache-Control "no-cache, must-revalidate";
    expires off;
  }
}
