# Annotator env — copy to .env and adjust. Never commit .env.
# Sections: [core] required to boot · [prod] cloud-only flags · [services] the
# gym + live-browser wiring · [workspace] isolation · [llm] · [auth] · [compose].

# ===== core (required) =====
DATABASE_URL=postgresql+psycopg://localhost:5432/browser_gym_annotator
# Signs session cookies. The PROD backend REFUSES TO BOOT without a real value
# (a weak/default secret = forgeable logins).  Generate:  openssl rand -hex 32
AUTH_SECRET=
ENV=dev                       # prod: production

# ===== prod-only (cloud) =====
# In prod, create the schema via Alembic — NOT create_all:
#   AUTO_CREATE_ALL=false   and   RUN_MIGRATIONS=1
# (dev leaves AUTO_CREATE_ALL=true and skips migrations.)
# AUTO_CREATE_ALL=false
# RUN_MIGRATIONS=1
# PORT=8090                   # injected by most platforms
# CORS_ORIGINS=[]             # browser hits /api same-origin via nginx → [] in prod
CORS_ORIGINS=["http://localhost:5180"]

# ===== service wiring (needed for the gym-review + live-pane features) =====
GYM_URL=http://localhost:8000
# MUST equal the gym service's HARNESS_TOKEN, or every gym call 401/503s.
GYM_HARNESS_TOKEN=
LIVE_BROWSER_URL=http://localhost:8877
# MUST equal the live-browser service's LIVE_STREAM_SECRET, or the live pane 4401s.
LIVE_STREAM_SECRET=
# NOTE: the browser reaches the live pane via the FRONTEND build arg VITE_LIVE_BASE
# (set at `make build` time in frontend/), NOT a backend var.

# ===== workspace isolation (single-host only; leave OFF for cloud) =====
# Spins one gym container per attempt via the Docker socket — impossible on
# Cloud Run / ECS Fargate. Off → the annotator shares the single GYM_URL.
# WORKSPACE_ISOLATION=false
# GYM_IMAGE=browser-gym:local

# ===== llm (optional — the live agent re-run; falls back to the gold path) =====
# ANTHROPIC_API_KEY=
# AGENT_MODEL=claude-haiku-4-5-20251001

# ===== auth knobs (optional) =====
# AUTH_ENABLED=true   ALLOW_REGISTRATION=false   AUTH_TTL_HOURS=168   AUTH_COOKIE=bg_auth

# ===== local docker-compose Postgres =====
POSTGRES_USER=annotator
POSTGRES_PASSWORD=annotator
POSTGRES_DB=browser_gym_annotator
# DB_PASS — used by the infra deploy scripts to provision the DB password.
